load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:build_defs.bzl", "repo_commands")

rust_binary(
    name = "dirlease",
    srcs = [
        "lease.rs",
        "main.rs",
        "service.rs",
    ],
    edition = "2024",
    rustc_flags = ["-Dwarnings"],
    visibility = ["//visibility:public"],
)

rust_test(
    name = "unit_test",
    crate = ":dirlease",
)

sh_test(
    name = "cli_test",
    srcs = ["cli_test.sh"],
    args = ["$(rootpath :dirlease)"],
    data = [":dirlease"],
)

test_suite(
    name = "test",
    tests = [
        ":cli_test",
        ":unit_test",
    ],
)

repo_commands(scope = "src")
