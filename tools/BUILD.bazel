load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//:build_defs.bzl", "repo_commands")

exports_files(
    ["quality.sh"],
    visibility = ["//visibility:public"],
)

filegroup(
    name = "quality_files",
    srcs = [
        "quality.py",
        "tool_versions.json",
    ],
    visibility = ["//visibility:public"],
)

sh_test(
    name = "quality_test",
    srcs = ["quality_test.sh"],
    data = [
        "quality.py",
        "quality_test.py",
    ],
)

sh_binary(
    name = "release",
    srcs = ["release.sh"],
    data = ["release.py"],
)

sh_test(
    name = "release_test",
    srcs = ["release_test.sh"],
    data = [
        "release.py",
        "release_test.py",
    ],
)

test_suite(
    name = "test",
    tests = [
        ":quality_test",
        ":release_test",
    ],
)

repo_commands(scope = "tools")
